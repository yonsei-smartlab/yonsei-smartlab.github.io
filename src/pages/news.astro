---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
const news = (await getCollection('news')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const years = [...new Set(news.map(item => item.data.date.slice(0, 4)))].sort().reverse();
const formatDate = (date: string) => new Intl.DateTimeFormat('en', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${date}T00:00:00Z`));
---
<BaseLayout title="News">
  <PageHeader title="News" description="SMART Lab news, research, and community activities." />
  <section class="section"><div class="container-page">
    <form class="news-filters publication-filters" role="search" aria-label="Filter news">
      <div class="search-field"><label for="news-search">Search</label><input id="news-search" type="search" placeholder="Topic, headline, or publisher" autocomplete="off" /></div>
      <div><label for="news-year">Year</label><select id="news-year"><option value="">All years</option>{years.map(year => <option value={year}>{year}</option>)}</select></div>
      <button class="button button-secondary reset-filters" type="reset">Reset</button>
    </form>
    <p class="results-count" aria-live="polite" aria-atomic="true"><span id="news-count">{news.length}</span> <span id="news-noun">reports</span></p>
    <ol class="news-list">
      {news.map(item => <li class="news-item" data-news data-year={item.data.date.slice(0, 4)} data-search={`${item.data.title} ${item.data.originalTitle} ${item.data.source} ${item.data.summary}`.toLowerCase()}>
        <div class="news-meta"><time datetime={item.data.date}>{formatDate(item.data.date)}</time><p>{item.data.source}</p></div>
        <article class:list={['news-content', { 'has-photo': item.data.image }]}>
          <div><h2><a href={item.data.url}>{item.data.title}</a></h2><p class="news-original" lang="ko">{item.data.originalTitle}</p><p class="news-summary">{item.data.summary}</p><a class="text-link" href={item.data.url}>Read the original report <span aria-hidden="true">→</span></a></div>
          {item.data.image && <figure class="news-photo"><a href={item.data.url}><img src={item.data.image} alt={item.data.imageAlt || item.data.title} width={item.data.imageWidth} height={item.data.imageHeight} loading="lazy" /></a>{item.data.imageCredit && <figcaption>{item.data.imageCredit}</figcaption>}</figure>}
        </article>
      </li>)}
    </ol>
    <p id="news-empty" class="empty-state" hidden>No reports match these filters.</p>
  </div></section>
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('.news-filters');
  const search = document.querySelector<HTMLInputElement>('#news-search');
  const year = document.querySelector<HTMLSelectElement>('#news-year');
  const entries = [...document.querySelectorAll<HTMLElement>('[data-news]')];
  const count = document.querySelector('#news-count');
  const noun = document.querySelector('#news-noun');
  const empty = document.querySelector<HTMLElement>('#news-empty');
  function filterNews() {
    const query = search?.value.trim().toLowerCase() ?? '';
    let visible = 0;
    for (const entry of entries) {
      const matches = (entry.dataset.search ?? '').includes(query)
        && (!year?.value || entry.dataset.year === year.value);
      entry.hidden = !matches;
      if (matches) visible++;
    }
    if (count) count.textContent = String(visible);
    if (noun) noun.textContent = visible === 1 ? 'report' : 'reports';
    if (empty) empty.hidden = visible !== 0;
  }
  search?.addEventListener('input', filterNews);
  year?.addEventListener('change', filterNews);
  form?.addEventListener('submit', event => event.preventDefault());
  // Wait for the native form reset to restore the controls before filtering.
  form?.addEventListener('reset', () => setTimeout(filterNews, 0));
</script>
