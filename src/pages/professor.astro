---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import { site } from '../data/site';
const professor = await getEntry('people', 'professor');
if (!professor) throw new Error('Professor biography is missing');
const { Content } = await render(professor);
---
<BaseLayout title="Professor" description={professor.data.summary}>
  <div class="container-page profile-page professor-profile">
    <div class="profile-intro">
      <PlaceholderImage label="Portrait" aspect="portrait" src={professor.data.photo} alt={professor.data.photoAlt || professor.data.name} />
      <div>
        <h1>{professor.data.name} <span lang="ko">({site.professorKoreanName})</span></h1>
        <p class="profile-role">{professor.data.role}</p>
        <div class="profile-affiliation">
          <p><span lang="ko">{site.universityKorean}</span><span>{site.university}</span></p>
          <p><span lang="ko">{site.collegeKorean}</span><span>{site.college}</span></p>
          <p><span lang="ko">{site.departmentKorean}</span><span>{site.department}</span></p>
        </div>
        <p class="profile-leadership">{professor.data.summary}</p>
        <div class="profile-links"><a href={`mailto:${site.email}`}>Email</a><a href={site.links.scholar}>Google Scholar</a><a href={site.links.facultyDetailed}>Yonsei profile</a><a href="/contact/">Contact</a></div>
      </div>
    </div>
    <div class="prose-content profile-bio"><Content /></div>
  </div>
</BaseLayout>
