---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import PlaceholderImage from '../../components/PlaceholderImage.astro';
import { getPeople } from '../../lib/content';
export async function getStaticPaths() {
  return (await getPeople()).filter(person => person.data.group !== 'Professor').map(person => ({ params: { slug: person.id }, props: { person } }));
}
interface Props { person: CollectionEntry<'people'>; }
const { person } = Astro.props;
const { Content } = await render(person);
---
<BaseLayout title={person.data.name} description={person.data.summary}>
  <div class="container-page profile-page">
    <a class="back-link" href="/people/">← Members</a>
    <div class="profile-intro"><PlaceholderImage label="Portrait" aspect="portrait" src={person.data.photo} alt={person.data.photoAlt || person.data.name} /><div><h1>{person.data.name}</h1><p class="profile-role">{person.data.role}</p><p>{person.data.summary}</p><div class="profile-links">{person.data.email && <a href={`mailto:${person.data.email}`}>Email</a>}{person.data.scholar && <a href={person.data.scholar}>Google Scholar</a>}{person.data.orcid && <a href={person.data.orcid}>ORCID</a>}</div></div></div>
    <div class="prose-content profile-bio"><Content /></div>
  </div>
</BaseLayout>
