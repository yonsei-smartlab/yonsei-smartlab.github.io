---
import BusInformation from '../components/BusInformation.astro';
import { officeBusInformation } from '../data/transport';
import PostalAddress from '../components/PostalAddress.astro';
import ContactPage from '../components/ContactPage.astro';
import { site } from '../data/site';
---
<ContactPage name={site.name} map={site.map}>
  <dl slot="details" class="contact-details">
    <dt>Professor</dt><dd><a href="/professor/">{site.professorName}, PT, PhD</a> <span class="local-name" lang="ko">({site.professorKoreanName})</span></dd>
    <dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
    <dt>Telephone</dt><dd><a href={`tel:${site.phone}`}>{site.phone}</a></dd>
    <dt>Fax</dt><dd>{site.fax}</dd>
    <dt>Affiliation</dt><dd>{site.fullName}<br />{site.university}<br />{site.college}<br />{site.department}<br />{site.campus}</dd>
  </dl>
  <dl slot="location" class="contact-details">
    <dt>Professor’s office</dt><dd><PostalAddress lines={site.address} korean={site.koreanAddress} /></dd>
  </dl>
  <BusInformation slot="transport" information={officeBusInformation} />
  <section class="section section-divided"><div class="container-page contact-opportunities">
    <section><h2>Join the lab</h2><p>{site.contact.opportunities}</p></section>
    <section><h2>How to apply</h2><p>Email <a href={`mailto:${site.email}`}>{site.email}</a> with a brief introduction, your CV, and a description of your research interests. {site.contact.applicationInstructions}</p></section>
    <section><h2>Collaborations</h2><p>{site.contact.collaboration}</p></section>
  </div></section>
</ContactPage>
