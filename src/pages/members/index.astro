---
import BaseLayout from '../../components/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PersonCard from '../../components/PersonCard.astro';
import { getPeople } from '../../lib/content';
import { academicAlumni, professionalAlumni, internationalCollaborators, rememberedCollaborator } from '../../data/members';
const people = await getPeople();
const groups = ['Researchers', 'Students'];
---
<BaseLayout title="Members">
  <PageHeader title="Members" description="SMART Lab researchers, students, alumni, and international collaborators." />
  <div class="container-page people-sections">
    <div class="current-members-grid">{groups.map(group => <section class="people-group"><h2>{group}</h2><div class="people-grid">{people.filter(person => person.data.group === group).map(person => <PersonCard person={person} />)}</div></section>)}</div>
    <section class="people-group directory-section" id="alumni" aria-labelledby="alumni-heading">
      <h2 id="alumni-heading">Alumni</h2>
      <h3 class="directory-subheading">Faculty</h3>
      <ul class="alumni-list">
        {academicAlumni.map(person => <li class="alumni-row" data-alumnus>
          <div class="directory-person"><h4 lang="ko">{person.name}</h4><p>{person.role}</p></div>
          {person.institution && <div class="alumni-affiliation"><p>{person.institution} <span lang="ko">{person.institutionKorean}</span></p><p>{person.department}</p></div>}
          {person.profile && <a class="directory-link" href={person.profile} target="_blank" rel="noopener noreferrer" aria-label={`Faculty profile: ${person.name}`}>Faculty profile <span aria-hidden="true">↗</span></a>}
        </li>)}
      </ul>
      <h3 class="directory-subheading">Research and professional practice</h3>
      <ul class="professional-alumni-list">
        {professionalAlumni.map(person => <li data-alumnus><h4 lang="ko">{person.name}</h4><p>{person.role}</p></li>)}
      </ul>
    </section>
    <section class="people-group directory-section" id="international-collaborators" aria-labelledby="collaborators-heading">
      <h2 id="collaborators-heading">International collaborators</h2>
      <ul class="collaborator-list">
        {internationalCollaborators.map(person => <li class="collaborator-row" data-collaborator>
          <div class="directory-person"><h3><a href={person.profile} target="_blank" rel="noopener noreferrer">{person.name}</a>{person.koreanName && <span class="directory-korean-name" lang="ko">{person.koreanName}</span>}</h3><p>{person.credentials}</p><p class="collaborator-specialty">{person.specialty}</p></div>
          <div class="collaborator-affiliation"><p>{person.institution}</p>{person.unit && <p>{person.unit}</p>}<p class="collaborator-location">{person.location}</p></div>
        </li>)}
      </ul>
      <div class="remembered-collaborator"><h3>In memoriam</h3><p><a href={rememberedCollaborator.profile} target="_blank" rel="noopener noreferrer">{rememberedCollaborator.name}, {rememberedCollaborator.credentials}</a> <span>({rememberedCollaborator.years})</span></p><p>{rememberedCollaborator.institution}</p><p>{rememberedCollaborator.specialty}</p></div>
    </section>
  </div>
</BaseLayout>
