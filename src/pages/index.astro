---
import BaseLayout from '../components/BaseLayout.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import PubList from '../components/PubList.astro';
import { site } from '../data/site';
import { getResearch, getPublications } from '../lib/content';
const areas = await getResearch();
const publications = await getPublications();
const selected = publications.filter(pub => pub.data.featured).slice(0, 3);
---
<BaseLayout>
  <section class="hero">
    <div class="container-page">
      <div class="hero-intro">
        <p class="affiliation">{site.university} · {site.department}</p>
        <h1>{site.name}</h1>
        <p class="institute-name">{site.fullName}</p>
        <p class="hero-description">{site.description}</p>
        <div class="hero-actions"><a class="button button-primary" href="/research/">Explore our research</a><a class="button button-secondary" href="/members/">Meet the team</a></div>
      </div>
      <div class="research-process">
        <ol class="process-steps">{site.researchSteps.map((step, index) => <li><span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h2>{step.title}</h2><p>{step.description}</p></li>)}</ol>
        <p class="process-note placeholder-text">{site.researchProcessDescription}</p>
      </div>
    </div>
  </section>
  <section class="section section-divided">
    <div class="container-page">
      <div class="section-heading"><h2>From our work</h2><a href="/research/">View research <span aria-hidden="true">→</span></a></div>
      <div class="figure-grid">{areas.slice(0, 3).map((area, index) => <a class="figure-card" href={`/research/#${area.id}`}><PlaceholderImage label={`Research figure ${index + 1}`} src={area.data.image} alt={area.data.imageAlt} /><div class="figure-caption"><p class="eyebrow">[Publication / project · Year]</p><h3>{area.data.title}</h3></div></a>)}</div>
    </div>
  </section>
  <section class="section">
    <div class="container-page"><div class="section-heading"><h2>Research areas</h2></div><div class="research-grid">{areas.map(area => <a class="research-card" href={`/research/#${area.id}`}><h3>{area.data.title}</h3><p>{area.data.summary}</p></a>)}</div></div>
  </section>
  <section class="section section-divided">
    <div class="container-page"><div class="section-heading"><h2>Selected publications</h2><a href="/publications/">All publications <span aria-hidden="true">→</span></a></div><PubList pubs={selected} /></div>
  </section>
</BaseLayout>
