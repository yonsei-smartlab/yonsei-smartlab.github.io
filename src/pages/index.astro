---
import BaseLayout from '../components/BaseLayout.astro';
import ResearchImageCredit from '../components/ResearchImageCredit.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import { site } from '../data/site';
import { getResearch } from '../lib/content';
const introBreak = site.description.indexOf(' We study');
const introParagraphs = introBreak > 0
  ? [site.description.slice(0, introBreak), site.description.slice(introBreak).trim()]
  : [site.description];
const areas = await getResearch();
---
<BaseLayout>
  <section class="hero">
    <div class="container-page">
      <div class="hero-intro">
        <p class="affiliation">{site.university} · {site.department}</p>
        <h1>{site.name}</h1>
        <p class="institute-name">{site.fullName}</p>
        <div class="hero-description hero-description-reading">{introParagraphs.map(paragraph => <p>{paragraph}</p>)}</div>
        <div class="hero-actions homepage-actions"><a class="button" href="/research/">Explore our research</a><a class="button" href="/publications/">Browse publications</a><a class="button" href="/news/">Read the latest news</a></div>
      </div>
      <div class="research-process">
        <ol class="process-steps">{site.researchSteps.map((step, index) => <li><span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h2><span class="step-title-line">{step.title.split(' ')[0]}</span>{' '}<span class="step-title-line">{step.title.split(' ').slice(1).join(' ')}</span></h2><p>{step.description}</p></li>)}</ol>
        <p class="process-note">{site.researchProcessDescription}</p>
      </div>
    </div>
  </section>
  <section class="section section-divided">
    <div class="container-page">
      <div class="section-heading"><h2>Research areas</h2><a href="/research/">View research <span aria-hidden="true">→</span></a></div>
      <div class="figure-grid">{areas.map(area => <article class="figure-card"><a class="figure-card-main" href={`/research/#${area.id}`}><PlaceholderImage label={`${area.data.title} image`} src={area.data.image} alt={area.data.imageAlt} /><div class="figure-caption"><h3>{area.data.title}</h3><p>{area.data.summary}</p>{area.data.imageCaption && <p class="eyebrow">{area.data.imageCaption}</p>}</div></a><ResearchImageCredit data={area.data} /></article>)}</div>
    </div>
  </section>
</BaseLayout>
<style>
  .homepage-actions .button {
    min-width: 140px;
    background: #fff;
    border-color: var(--brand);
    color: var(--brand);
    transition: background-color 160ms ease, border-color 160ms ease;
  }
  .homepage-actions .button:hover { background: var(--brand); border-color: var(--brand); color: #fff; }
  .homepage-actions .button:focus-visible {
    outline: 2px solid var(--brand-hover);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .homepage-actions .button { transition: none; }
  }
</style>
