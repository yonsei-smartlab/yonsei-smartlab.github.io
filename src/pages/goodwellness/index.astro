---
import BaseLayout from '../../components/BaseLayout.astro';
import PlaceholderImage from '../../components/PlaceholderImage.astro';
import { goodwellness as center } from '../../data/goodwellness';
---
<BaseLayout section="goodwellness">
  <section class="center-hero">
    <div class="container-page center-hero-grid">
      <div>
        <p class="affiliation"><span lang="ko">{center.koreanName}</span></p>
        <h1>{center.name}</h1>
        <p class="center-tagline">{center.tagline}</p>
        <p class="center-hero-description">Bringing rehabilitation robotics from the lab to the community.</p>
        <div class="center-actions"><a class="button button-primary" href="/goodwellness/robogym/">Rehabilitation robotics</a><a class="button button-secondary" href="/goodwellness/about/">About the center</a></div>
      </div>
      <PlaceholderImage label="Center photograph" aspect="photo" src={center.images.gymPhoto} alt={center.images.gymPhotoAlt} />
    </div>
    <div class="container-page"><dl class="center-metrics">{center.metrics.map(metric => <div><dt>{metric.value}</dt><dd>{metric.label}<small>{metric.detail}</small></dd></div>)}</dl></div>
  </section>
  <section class="section"><div class="container-page center-overview"><div><p class="center-kicker">Community rehabilitation</p><h2>Advanced robotics, close to everyday life</h2></div><div><p>Supported by Wonju City, Yonsei GOODWELLNESS Center provides rehabilitation, exercise, and wellness services for children, adults, older adults, and people with disabilities.</p><p>The center brings robotic rehabilitation into the community for people with neurological and musculoskeletal conditions.</p><a class="text-link" href="/goodwellness/about/">Our community model <span aria-hidden="true">→</span></a></div></div></section>
  <section class="section section-divided"><div class="container-page"><div class="section-heading"><h2>Rehabilitation robotics</h2><a href="/goodwellness/robogym/">Rehabilitation robotics <span aria-hidden="true">→</span></a></div><div class="center-card-grid">{center.technologies.map(technology => <article class="center-card"><h3>{technology.title}</h3><p>{technology.description}</p></article>)}</div></div></section>
  <section class="section section-divided"><div class="container-page center-overview"><div><p class="center-kicker">Research · Clinical practice · Education</p><h2>A living lab for rehabilitation robotics</h2></div><div><p>Students, clinicians, researchers, and engineers gain professional knowledge and practical clinical experience with rehabilitation robotics in a community setting.</p><p>Research through the center has contributed to more than 50 SCI-indexed publications in rehabilitation robotics and related fields.</p><a class="text-link" href="/goodwellness/research-education/">Research and education <span aria-hidden="true">→</span></a></div></div></section>
</BaseLayout>
