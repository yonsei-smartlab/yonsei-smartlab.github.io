---
import BaseLayout from '../../components/BaseLayout.astro';
import { goodwellness as center } from '../../data/goodwellness';
---
<BaseLayout section="goodwellness">
  <section class="hero center-home">
    <div class="container-page">
      <div class="hero-intro">
        <p class="affiliation">Community rehabilitation · Wonju, Republic of Korea</p>
        <h1>{center.name}</h1>
        <p class="institute-name">{center.tagline}</p>
        <p class="hero-description">Rehabilitation, exercise, and wellness for children, adults, older adults, and people with disabilities.</p>
        <div class="hero-actions"><a class="button button-primary" href="/goodwellness/robogym/">Rehabilitation robotics</a><a class="button button-secondary" href="/goodwellness/about/">About the center</a></div>
      </div>
    </div>
    <div class="container-page"><dl class="center-metrics">{center.metrics.map(metric => <div><dt>{metric.value}</dt><dd>{metric.label}<small>{metric.detail}</small></dd></div>)}</dl></div>
  </section>
  <section class="section"><div class="container-page center-overview"><div><h2>Overview</h2></div><div><p>Supported by Wonju City, Yonsei GOODWELLNESS Center provides rehabilitation, exercise, and wellness services for children, adults, older adults, and people with disabilities.</p><p>The center brings robotic rehabilitation into the community for people with neurological and musculoskeletal conditions.</p><a class="text-link" href="/goodwellness/about/">About the center <span aria-hidden="true">→</span></a></div></div></section>
  <section class="section section-divided"><div class="container-page"><div class="section-heading"><h2>Rehabilitation robotics</h2><a href="/goodwellness/robogym/">View rehabilitation robotics <span aria-hidden="true">→</span></a></div><div class="center-card-grid">{center.technologies.map(technology => <article class="center-card"><h3>{technology.title}</h3><p>{technology.description}</p></article>)}</div></div></section>
  <section class="section section-divided"><div class="container-page center-overview"><div><h2>Research and education</h2></div><div><p>Students, clinicians, researchers, and engineers gain professional knowledge and practical clinical experience with rehabilitation robotics in a community setting.</p><p>Research through the center has contributed to more than 50 SCI-indexed publications in rehabilitation robotics and related fields.</p><a class="text-link" href="/goodwellness/research-education/">Research and education <span aria-hidden="true">→</span></a></div></div></section>
</BaseLayout>
