---
import BusInformation from '../../components/BusInformation.astro';
import { centerBusInformation } from '../../data/transport';
import PostalAddress from '../../components/PostalAddress.astro';
import ContactPage from '../../components/ContactPage.astro';
import { goodwellness as center } from '../../data/goodwellness';
---
<ContactPage section="goodwellness" name={center.name} map={center.map}>
  <dl slot="details" class="contact-details">
    <dt>Telephone</dt><dd><a href={`tel:${center.contact.phoneHref}`}>{center.contact.phone}</a></dd>
  </dl>
  <dl slot="location" class="contact-details">
    <dt>Street address</dt><dd><PostalAddress lines={center.contact.address} korean={center.contact.roadAddress} /></dd>
    <dt>Lot address</dt><dd>{center.contact.lotAddressEnglish}<span class="secondary-language" lang="ko">{center.contact.lotAddress}</span></dd>
  </dl>
  <BusInformation slot="transport" information={centerBusInformation} />
</ContactPage>
