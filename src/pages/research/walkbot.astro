---
import BaseLayout from '../../components/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ResearchNav from '../../components/ResearchNav.astro';
import PubList from '../../components/PubList.astro';
import { walkbot } from '../../data/walkbot';
import { getPublications } from '../../lib/content';
const publications = (await getPublications()).filter(pub => walkbot.publicationScholarIds.includes(pub.data.scholarId ?? '') || walkbot.publicationIds.includes(pub.id));
if (publications.length !== walkbot.publicationScholarIds.length + walkbot.publicationIds.length) throw new Error('Walkbot publication references must match the public bibliography.');
---
<BaseLayout title="Walkbot" description="Walkbot robotic gait training and related research publications.">
  <PageHeader title="Walkbot" description="Robotic gait training and related research." />
  <ResearchNav />
  <section class="section">
    <div class="container-page">
      <div class="walkbot-intro"><h2>{walkbot.title}</h2><p>{walkbot.introduction}</p></div>
      <div class="walkbot-grid">
        <article class="walkbot-card">
          <p class="eyebrow">Company</p><h3>{walkbot.company.name}</h3><p class="walkbot-korean" lang="ko">{walkbot.company.koreanName}</p>
          <p>{walkbot.company.description}</p>
          <a class="text-link" href={walkbot.company.url}>Visit P&S Robotics / Walkbot <span aria-hidden="true">↗</span></a>
        </article>
        <article class="walkbot-card">
          <p class="eyebrow">Robotic gait training</p><h3>{walkbot.product.name}</h3><p class="walkbot-korean" lang="ko">{walkbot.product.koreanName}</p>
          <p>{walkbot.product.description}</p>
          <a class="text-link" href={walkbot.product.url}>Explore the Walkbot systems <span aria-hidden="true">↗</span></a>
        </article>
      </div>
    </div>
  </section>
  <section class="section section-divided"><div class="container-page"><div class="section-heading"><h2>Research history</h2></div><div class="walkbot-grid">{walkbot.researchHistory.map(item => <article class="walkbot-card"><p class="eyebrow">{item.period}</p><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></div></section>
  <section class="section section-divided">
    <div class="container-page">
      <div class="section-heading"><h2>Related publications</h2><a href="/publications/">All publications <span aria-hidden="true">→</span></a></div>
      <PubList pubs={publications} />
    </div>
  </section>
</BaseLayout>
