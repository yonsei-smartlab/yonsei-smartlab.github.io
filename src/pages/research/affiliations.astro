---
import BaseLayout from '../../components/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ResearchNav from '../../components/ResearchNav.astro';
import PubList from '../../components/PubList.astro';
import { walkbotAffiliation as affiliation } from '../../data/affiliations';
import { getPublications } from '../../lib/content';
const publications = (await getPublications()).filter(pub => affiliation.publicationScholarIds.includes(pub.data.scholarId ?? ''));
if (publications.length !== affiliation.publicationScholarIds.length) throw new Error('Affiliation publication references must match the public bibliography.');
---
<BaseLayout title="Affiliations" description="SMART Lab’s affiliation with P&S Robotics and the Walkbot robotic gait-training system.">
  <PageHeader title="Affiliations" description="SMART Lab’s industry affiliation in rehabilitation robotics." />
  <ResearchNav />
  <section class="section">
    <div class="container-page">
      <div class="affiliation-intro"><h2>{affiliation.title}</h2><p>{affiliation.introduction}</p></div>
      <div class="affiliation-grid">
        <article class="affiliation-card">
          <p class="eyebrow">Company</p><h3>{affiliation.company.name}</h3><p class="affiliation-korean" lang="ko">{affiliation.company.koreanName}</p>
          <p>{affiliation.company.description}</p>
          <a class="text-link" href={affiliation.company.url}>Visit P&S Robotics / Walkbot <span aria-hidden="true">↗</span></a>
        </article>
        <article class="affiliation-card">
          <p class="eyebrow">Robotic gait training</p><h3>{affiliation.product.name}</h3><p class="affiliation-korean" lang="ko">{affiliation.product.koreanName}</p>
          <p>{affiliation.product.description}</p>
          <a class="text-link" href={affiliation.product.url}>Explore the Walkbot systems <span aria-hidden="true">↗</span></a>
        </article>
      </div>
    </div>
  </section>
  <section class="section section-divided">
    <div class="container-page">
      <div class="section-heading"><h2>Related publications</h2><a href="/publications/">All publications <span aria-hidden="true">→</span></a></div>
      <PubList pubs={publications} />
    </div>
  </section>
</BaseLayout>
