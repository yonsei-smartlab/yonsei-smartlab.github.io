---
import BaseLayout from '../../components/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ResearchNav from '../../components/ResearchNav.astro';
import PubList from '../../components/PubList.astro';
import { affiliations } from '../../data/affiliations';
import { getPublications } from '../../lib/content';
const publications = (await getPublications()).filter(pub => affiliations.publicationScholarIds.includes(pub.data.scholarId ?? ''));
if (publications.length !== affiliations.publicationScholarIds.length) throw new Error('Walkbot publication references must match the public bibliography.');
---
<BaseLayout title="Affiliations" description="SMART Lab affiliation with P&S Robotics and its Walkbot robotic gait-training system.">
  <PageHeader title="Affiliations" description="P&S Robotics and Walkbot." />
  <ResearchNav />
  <section class="section">
    <div class="container-page">
      <div class="walkbot-intro"><h2>{affiliations.title}</h2><p>{affiliations.introduction}</p></div>
      <div class="walkbot-grid">
        <article class="walkbot-card">
          <p class="eyebrow">Company</p><h3>{affiliations.company.name}</h3><p class="walkbot-korean" lang="ko">{affiliations.company.koreanName}</p>
          <p>{affiliations.company.description}</p>
          <a class="text-link" href={affiliations.company.url}>Visit P&S Robotics / Walkbot <span aria-hidden="true">↗</span></a>
        </article>
        <article class="walkbot-card">
          <p class="eyebrow">Robotic gait training</p><h3>{affiliations.product.name}</h3><p class="walkbot-korean" lang="ko">{affiliations.product.koreanName}</p>
          <p>{affiliations.product.description}</p>
          <a class="text-link" href={affiliations.product.url}>Explore the Walkbot systems <span aria-hidden="true">↗</span></a>
        </article>
      </div>
    </div>
  </section>
  <section class="section section-divided">
    <div class="container-page">
      <div class="section-heading"><h2>Related publications</h2><a href="/publications/">All publications <span aria-hidden="true">→</span></a></div>
      <PubList pubs={publications} />
    </div>
  </section>
</BaseLayout>
