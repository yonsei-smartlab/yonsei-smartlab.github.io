---
import '../styles/global.css';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { site } from '../data/site';
import { goodwellness } from '../data/goodwellness';
interface Props { title?: string; description?: string; section?: 'lab' | 'goodwellness'; }
const { title, description: suppliedDescription, section = 'lab' } = Astro.props;
const identity = section === 'goodwellness' ? goodwellness : site;
const themeColor = section === 'goodwellness' ? '#7b233e' : '#003477';
const description = suppliedDescription ?? `${identity.fullName} at ${site.university}. ${identity.description}`;
const pageTitle = title ? `${title} | ${identity.name}` : `${identity.name} | ${site.university}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
---
<!doctype html>
<html lang="en" data-site={section}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={section === 'goodwellness' ? '/goodwellness-favicon.svg' : '/favicon.svg'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav section={section} />
    <main id="main"><slot /></main>
    <Footer section={section} />
  </body>
</html>
