---
import BaseLayout from './BaseLayout.astro';
import PageHeader from './PageHeader.astro';
import LocationMap from './LocationMap.astro';
interface Props {
  section?: 'lab' | 'goodwellness';
  name: string;
  map: { label: string; latitude: number; longitude: number; searchQuery: string; naverUrl?: string };
}
const { section = 'lab', name, map } = Astro.props;
---
<BaseLayout section={section} title="Contact">
  <PageHeader title="Contact" description={`Contact details and location for ${name}.`} />
  <section class="section"><div class="container-page contact-grid">
    <div class="contact-column"><section aria-labelledby="contact-heading"><h2 id="contact-heading">Contact</h2><slot name="details" /></section></div>
    <div class="contact-column"><section aria-labelledby="location-heading"><h2 id="location-heading">Location</h2><slot name="location" /><LocationMap map={map} /><slot name="transport" /></section></div>
  </div></section>
  <slot />
</BaseLayout>
