---
import { site } from '../data/site';
interface Props { map?: { latitude: number; longitude: number; label: string; bbox?: string }; }
const { map = site.map } = Astro.props;
const { latitude, longitude, label } = map;
const query = new URLSearchParams({
  bbox: map.bbox ?? `${longitude - 0.0031},${latitude - 0.002},${longitude + 0.0031},${latitude + 0.002}`,
  layer: 'mapnik',
  marker: `${latitude},${longitude}`,
});
const mapUrl = `https://www.openstreetmap.org/?mlat=${latitude}&mlon=${longitude}#map=17/${latitude}/${longitude}`;
---
<figure class="location-map">
  <iframe src={`https://www.openstreetmap.org/export/embed.html?${query}`} title={`Map showing ${label}`} loading="lazy" referrerpolicy="no-referrer" width="480" height="320"></iframe>
  <figcaption>{label} · <a href={mapUrl}>Open larger map</a><br /><small>© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a></small></figcaption>
</figure>
