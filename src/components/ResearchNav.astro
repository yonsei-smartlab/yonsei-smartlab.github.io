---
import { researchNavigation } from '../data/research-navigation';
const current = Astro.url.pathname.replace(/\/$/, '');
---
<nav class="container-page research-nav" aria-label="Research navigation">
  {researchNavigation.map(link => <a href={link.href} aria-current={current === link.href.replace(/\/$/, '') ? 'page' : undefined}>{link.label}</a>)}
</nav>
