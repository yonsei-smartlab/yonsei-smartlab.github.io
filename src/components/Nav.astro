---
import { site } from '../data/site';
import { goodwellness } from '../data/goodwellness';
import { peopleNavigation } from '../data/people-navigation';
import { researchNavigation } from '../data/research-navigation';
interface Props { section?: 'lab' | 'goodwellness'; }
const { section = 'lab' } = Astro.props;
const isCenter = section === 'goodwellness';
const navigation = isCenter ? goodwellness.nav : site.nav;
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <nav class="container-page nav-inner" aria-label="Main navigation">
    <div class="site-switcher" role="group" aria-label="Websites">
      <a class="university-logo" href="https://www.yonsei.ac.kr/" aria-label="Yonsei University">
        <img src="/images/yonsei-university-seal.jpg" alt="" width="1907" height="2268" />
      </a>
      <a class="wordmark" data-website="lab" href="/" aria-current={!isCenter ? 'location' : undefined}>{site.name}</a>
      <a class="wordmark" data-website="goodwellness" href={goodwellness.home} aria-current={isCenter ? 'location' : undefined}>{goodwellness.headerName}</a>
    </div>
    <button class="nav-toggle" type="button" aria-controls="main-menu" aria-expanded="false">
      <span>Menu</span><span class="menu-glyph" aria-hidden="true">☰</span>
    </button>
    <ul id="main-menu" class="nav-list">
      {navigation.map(item => {
        const path = item.href.replace(/\/$/, '') || '/';
        const home = isCenter ? goodwellness.home.replace(/\/$/, '') : '/';
        const active = path === home ? current === home : current === path || current.startsWith(path + '/') || (!isCenter && path === '/research' && current === '/training');
        const submenuLinks = !isCenter && path === '/research' ? researchNavigation.map(link => ({ label: link.dropdownLabel, href: link.href })) : !isCenter && path === '/people' ? peopleNavigation : [];
        const hasSubmenu = submenuLinks.length > 0;
        const submenuId = `${item.label.toLowerCase()}-submenu`;
        return <li class:list={{ 'nav-dropdown': hasSubmenu }}>
          <div class="nav-item-heading">
            <a data-nav-primary href={item.href} aria-current={active ? 'page' : undefined}>{item.label}</a>
            {hasSubmenu && <button class="submenu-toggle" type="button" aria-label={`${item.label} subsections`} aria-controls={submenuId} aria-expanded="false"><span aria-hidden="true">⌄</span></button>}
          </div>
          {hasSubmenu && <ul id={submenuId} class="nav-submenu" hidden>
            {submenuLinks.map(link => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>}
        </li>;
      })}
    </ul>
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.querySelector<HTMLUListElement>('#main-menu');
  const dropdowns = [...document.querySelectorAll<HTMLLIElement>('.nav-dropdown')].map(dropdown => {
    const button = dropdown.querySelector<HTMLButtonElement>('.submenu-toggle');
    const submenu = dropdown.querySelector<HTMLUListElement>('.nav-submenu');
    function setOpen(open: boolean) {
      button?.setAttribute('aria-expanded', String(open));
      if (submenu) submenu.hidden = !open;
    }
    function openMenu() {
      dropdowns.forEach(item => item.setOpen(item.dropdown === dropdown));
    }
    button?.addEventListener('click', () => {
      if (button.getAttribute('aria-expanded') === 'true') setOpen(false);
      else openMenu();
    });
    dropdown.addEventListener('pointerenter', event => {
      if (event.pointerType === 'mouse' && window.matchMedia('(min-width: 860px)').matches) openMenu();
    });
    dropdown.addEventListener('pointerleave', () => {
      if (!dropdown.contains(document.activeElement)) setOpen(false);
    });
    dropdown.addEventListener('focusout', event => {
      if (!(event.relatedTarget instanceof Node) || !dropdown.contains(event.relatedTarget)) setOpen(false);
    });
    return { dropdown, button, setOpen };
  });
  function closeMenu() {
    dropdowns.forEach(item => item.setOpen(false));
    toggle?.setAttribute('aria-expanded', 'false');
    menu?.classList.remove('is-open');
  }
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    if (!open) closeMenu();
    else {
      toggle.setAttribute('aria-expanded', 'true');
      menu?.classList.add('is-open');
    }
  });
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
  document.addEventListener('click', event => {
    if (event.target instanceof Node && !dropdowns.some(item => item.dropdown.contains(event.target as Node))) dropdowns.forEach(item => item.setOpen(false));
  });
  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return;
    const openDropdown = dropdowns.find(item => item.button?.getAttribute('aria-expanded') === 'true');
    if (openDropdown) {
      openDropdown.setOpen(false);
      openDropdown.button?.focus();
    } else if (toggle?.getAttribute('aria-expanded') === 'true') {
      closeMenu();
      toggle.focus();
    }
  });
  window.matchMedia('(min-width: 860px)').addEventListener('change', closeMenu);
</script>
