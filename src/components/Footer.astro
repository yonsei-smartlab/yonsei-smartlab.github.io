---
import { site } from '../data/site';
import { goodwellness } from '../data/goodwellness';
interface Props { section?: 'lab' | 'goodwellness'; }
const { section = 'lab' } = Astro.props;
const isCenter = section === 'goodwellness';
const identity = isCenter ? goodwellness : site;
---
<footer class="site-footer">
  <div class="container-page">
    <div class="footer-grid">
      {isCenter ? <>
        <div><p class="footer-name">{goodwellness.name}</p><p lang="ko">{goodwellness.koreanName}</p></div>
        <div><h2>Address</h2><p lang="ko">도로명: {goodwellness.contact.roadAddress}</p><p lang="ko">지번: {goodwellness.contact.lotAddress}</p></div>
        <div><h2>Telephone</h2><a href={`tel:${goodwellness.contact.phoneHref}`}>{goodwellness.contact.phone}</a></div>
      </> : <>
        <div><p class="footer-name">{site.name}</p><p>{site.fullName}</p><p>{site.university}</p><p>{site.college}</p><p>{site.department}</p></div>
        <div><h2>Location</h2>{site.address.map(line => <p>{line}</p>)}</div>
        <div><h2>Contact</h2>{site.email ? <a href={`mailto:${site.email}`}>{site.email}</a> : <p class="placeholder-text">[Lab email address]</p>}<p><a href="/contact/">Contact</a></p></div>
      </>}
    </div>
    <div class="footer-bottom"><p>© {new Date().getFullYear()} {identity.name}</p></div>
  </div>
</footer>
